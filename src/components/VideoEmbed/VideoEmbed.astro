---
const { vimeoId, title, full = false } = Astro.props;
---

<div class:list={["video", full && "video--full"]} style="--aspect-ratio:16/9;">
  <iframe
    src={`https://player.vimeo.com/video/${vimeoId}?color=4f51a9`}
    title={`Video: ${title}`}
    width="640"
    height="360"
    loading="lazy"
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style is:global>
  @import "./VideoEmbed.css" layer(blocks);
</style>
