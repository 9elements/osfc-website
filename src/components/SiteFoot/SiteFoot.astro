---
import { Icon } from "astro-icon/components";

const links = [
  {
    icon: "telephone",
    text: "+49 234 689 41 88",
    href: "tel:+492346894188",
  },
  { icon: "mail", text: "Contact", href: "mailto:info@osfc.io" },
  {
    icon: "twitter",
    text: "Twitter",
    href: "https://twitter.com/osfc_io",
  },
  {
    icon: "linkedin",
    text: "LinkedIn",
    href: "https://www.linkedin.com/company/osff",
  },
  { icon: "imprint", text: "Imprint", href: "/imprint/" },
  {
    icon: "data_privacy",
    text: "Privacy Policy",
    href: "/privacy-policy/",
  },
];
---

<footer class="site-foot | bg-violet text-white">
  <div class="wrapper-l">
    <div class="site-foot__inner stack-300">
      <div class="footer-statement">
        <p class="leading-tight text-400 weight-bold">
          Made with 🤍 by <a href="https://9esec.io/">9elements</a> in Bochum
        </p>
      </div>
      <ul class="site-foot__list text-400">
        <li>
          <Icon name="pin" class="site-foot__icon" aria-hidden="true" />
          Kortumstraße 19-21, 44787 Bochum
        </li>
        {
          links.map(({ icon, text, href }) => (
            <li>
              <Icon name={icon} class="site-foot__icon" aria-hidden="true" />
              <a href={href}>{text}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style is:global>
  @import "./SiteFoot.css" layer(blocks);
</style>
