---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Error" noindex>
  <div class="wrapper-m stack-600 py-900">
    <h1 class="text-800-major weight-black text-peach uppercase">
      Error 404 – Page not found
    </h1>
    <p>You might have mistyped the URL or the page doesn't exist anymore.</p>
    <p><a href="/">Back home</a></p>
  </div>
</BaseLayout>
