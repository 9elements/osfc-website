---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Newsletter from "@/components/Newsletter/Newsletter.astro";
import RhombImage from "@/components/RhombImage/RhombImage.astro";
import RhombDefs from "@/components/RhombDefs/RhombDefs.astro";
import IntroDecoration from "@/assets/svg/intro-decoration.svg";
import Logo from "@/assets/svg/logo-no-year.svg";
import nineElementsLogo from "@/assets/images/organizer/9e_logo_black.svg";
import venueMap from "@/assets/images/oscar_map_netherlands.png";
import { site } from "@/data/site";
import { getSponsors } from "@/utils/sponsors";
import { webSiteJsonLd } from "@/utils/seo";

const byOrder = (a, b) => a.data.order - b.data.order;
const projects = (await getCollection("projects")).sort(byOrder);
const organizers = (await getCollection("organizers")).sort(byOrder);
const sponsors = await getSponsors();

const mapsUrl = "https://maps.app.goo.gl/GqKyRCQtUduvPuas9";
---

<BaseLayout
  title={site.name}
  metaTitle="OSFC - Open Source Firmware Conference"
  jsonLd={[webSiteJsonLd]}
  triangle
>
  <RhombDefs />

  <div class="stack-major">
    <section id="intro" class="intro">
      <IntroDecoration aria-hidden="true" />
      <div class="wrapper-m">
        <h1 class="hero__logo intro__branding">
          <Logo aria-hidden="true" />
          <span class="sr-only">OSFC – Open Source Firmware Conference</span>
        </h1>
      </div>
    </section>

    <section id="mission" class="mission">
      <div class="wrapper-l stack-600">
        <div class="stack-300 shadow-box bg-light-gray mission__text">
          <h2
            class="uppercase text-peach weight-black text-800-major leading-flat"
          >
            Mission
          </h2>
          <p class="leading-tight text-peach weight-bold text-600-700">
            Change the way of firmware development, collaborate with others and
            share knowledge.
          </p>
          <p class="text-500-600">
            Closed source firmware development has been the de-facto standard
            for the electronics industry since its inception. That didn't change
            even when open-source took off in other areas. Now, with changing
            use cases and strict security requirements, it's more important than
            ever to take open-source firmware development to the next level.
            That's why we're inviting you to the Open Source Firmware
            Conference.
          </p>
          <p
            class="uppercase text-peach weight-black text-400-500 leading-flat"
          >
            <a class="button" href="/archive/2026/">Watch the 2026 talks</a>
          </p>
        </div>
        <RhombImage
          name="9elements Cyber Security"
          image={nineElementsLogo}
          box={{ imageSize: 220, offset: 55 }}
          href="https://9esec.io/"
          external
          utm={false}
        />
      </div>
    </section>

    <section id="venue" class="venue">
      <img
        loading="lazy"
        decoding="async"
        alt=""
        class="venue__beam"
        src="/assets/images/beams/beam-01.svg"
        aria-hidden="true"
      />
      <div class="wrapper-l stack-600">
        <div class="stack-300 venue__text bg-light-gray">
          <h2
            class="text-black uppercase weight-black text-800-major leading-flat"
          >
            Venue
          </h2>
          <p class="text-400-500 weight-bold">
            OSFC 2026 took place at Pakhuis de Zwijger in Amsterdam – thank you
            for being there! 🇳🇱
          </p>
          <p class="text-400-500 weight-bold">
            We are already looking for the 2027 venue. Stay tuned and subscribe
            to our <a href={site.newsletterUrl} target="_blank" rel="noopener"
              >NEWSLETTER</a
            >!
          </p>
          <p
            class="uppercase text-peach weight-black text-400-500 leading-flat"
          >
            <a class="button" href="/info/">2026 Recap</a>
          </p>
        </div>

        <RhombImage
          name="Venue on Google Maps"
          image={venueMap}
          href={mapsUrl}
          external
          utm={false}
        />
      </div>
    </section>

    <section id="projects" class="projects">
      <div class="wrapper-l">
        <div class="stack-300">
          <h2
            class="text-black uppercase weight-black text-800-major leading-flat"
          >
            Projects
          </h2>
          <div class="rhomb-grid">
            {
              projects.map(({ data }) => (
                <RhombImage
                  name={data.name}
                  image={data.image}
                  size={data.size}
                  href={data.link}
                  external
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="organizer" class="organizer">
      <div class="wrapper-l">
        <div class="stack-800">
          <h2
            class="text-black uppercase weight-black text-800-major leading-flat"
          >
            Organizers
          </h2>
          <div class="rhomb-grid">
            {
              organizers.map(({ data }) => (
                <RhombImage
                  name={data.name}
                  image={data.image}
                  size={data.size}
                  href={data.link}
                  external
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="sponsors" class="sponsors">
      <img
        loading="lazy"
        decoding="async"
        alt=""
        class="sponsors__beam"
        src="/assets/images/beams/beam-05.svg"
        aria-hidden="true"
      />
      <img
        loading="lazy"
        decoding="async"
        alt=""
        class="sponsors__beam sponsors__beam--1"
        src="/assets/images/beams/small_grey_stripe_left.svg"
        aria-hidden="true"
      />
      <img
        loading="lazy"
        decoding="async"
        alt=""
        class="sponsors__beam sponsors__beam--2"
        src="/assets/images/beams/big_grey_stripe_left.svg"
        aria-hidden="true"
      />
      <div class="wrapper-l">
        <div class="stack-800">
          <h2
            class="text-black uppercase weight-black text-800-major leading-flat"
          >
            Sponsors
          </h2>
          <div class="rhomb-grid">
            {
              sponsors.map((sponsor) => (
                <RhombImage
                  name={sponsor.name}
                  image={sponsor.image}
                  size={sponsor.size}
                  href={sponsor.url}
                  tier={sponsor.sponsor}
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <Newsletter />
  </div>
</BaseLayout>

<style is:global>
  @import "../styles/pages/home.css" layer(blocks);
</style>
